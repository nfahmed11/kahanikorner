export function buildVariantLookup(vocabList) {
  const lookup = {};

  const normalizeKey = (key) => {
    if (!key) return "";
    return key.trim().toLowerCase();
  };

  const addEntry = ({
    key,
    parentId,
    matchType,
    romanUrdu,
    urdu,
    baseRomanUrdu,
    baseUrdu,
    english,
    pos,
    gender,
    number,
    form,
    image,
  }) => {
    if (!key) return;

    const finalKey = normalizeKey(key);

    lookup[finalKey] = {
      parentId,
      matchType,
      romanUrdu,
      urdu,
      baseRomanUrdu,
      baseUrdu,
      english,
      pos,
      gender,
      number,
      form,
      image,
    };
  };

  vocabList.forEach((entry) => {
    addEntry({
      key: entry.word.baseRomanUrdu,
      parentId: entry.id,
      matchType: "base",
      romanUrdu: entry.word.baseRomanUrdu,
      urdu: entry.word.baseUrdu,
      baseRomanUrdu: entry.word.baseRomanUrdu,
      baseUrdu: entry.word.baseUrdu,
      english: entry.word.english,
      pos: entry.word.pos,
      gender: entry.grammar.baseGender,
      number: null,
      form: "base",
      image: entry.image,
    });

    addEntry({
      key: entry.word.baseUrdu,
      parentId: entry.id,
      matchType: "base",
      romanUrdu: entry.word.baseRomanUrdu,
      urdu: entry.word.baseUrdu,
      baseRomanUrdu: entry.word.baseRomanUrdu,
      baseUrdu: entry.word.baseUrdu,
      english: entry.word.english,
      pos: entry.word.pos,
      gender: entry.grammar.baseGender,
      number: null,
      form: "base",
      image: entry.image,
    });

    const variants = Array.isArray(entry.variants) ? entry.variants : [];

    variants.forEach((variant) => {
      addEntry({
        key: variant.romanUrdu,
        parentId: entry.id,
        matchType: "variant",
        romanUrdu: variant.romanUrdu,
        urdu: variant.urdu,
        baseRomanUrdu: entry.word.baseRomanUrdu,
        baseUrdu: entry.word.baseUrdu,
        english: entry.word.english,
        pos: entry.word.pos,
        gender: variant.gender,
        number: variant.number,
        form: variant.form,
        image: entry.image,
      });

      addEntry({
        key: variant.urdu,
        parentId: entry.id,
        matchType: "variant",
        romanUrdu: variant.romanUrdu,
        urdu: variant.urdu,
        baseRomanUrdu: entry.word.baseRomanUrdu,
        baseUrdu: entry.word.baseUrdu,
        english: entry.word.english,
        pos: entry.word.pos,
        gender: variant.gender,
        number: variant.number,
        form: variant.form,
        image: entry.image,
      });
    });
  });

  return lookup;
}

export const variantLookup = buildVariantLookup(vocab);
