{
  "hosting": {
    "public": ".",
    "cleanUrls": true,
    "ignore": [
      "firebase.json",
      "functions/**",
      "tools/**",
      "**/.*",
      "**/.*/**",
      "**/node_modules/**"
    ],
    "headers": [
      {
        "source": "/assets/images/opt/**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=604800"
          }
        ]
      }
    ],
    "redirects": [
      {
        "source": "/index.html",
        "destination": "/",
        "type": 301
      },
      {
        "regex": "^/(?P<dir>.+)/index\\.html$",
        "destination": "/:dir/",
        "type": 301
      },
      {
        "regex": "^/(?P<dir>resources/free|qr/tkt/[^/.]+|qr/tkt/20[0-9]{2}/[^/.]+|qr/book/[^/.]+|qr/book/[^/.]+/TheKahaniTimes)$",
        "destination": "/:dir/",
        "type": 301
      }
    ],
    "rewrites": [
      {
        "source": "/create-checkout-session",
        "function": "createCheckoutSession"
      },
      {
        "source": "/api/checkout/kahani-times-archive",
        "function": "createArchiveCheckout"
      },
      {
        "source": "/api/generate-sentence",
        "function": "generateSentence"
      }
    ]
  },
  "functions": {
    "source": "functions"
  }
}
